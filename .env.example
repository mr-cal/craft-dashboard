# Application configuration — used by pydantic-settings at startup.
#
# Local dev: docker-compose.yml sets DATABASE_URL automatically using
# the hardcoded devpassword. You do not need DATABASE_URL or DB_PASSWORD here.
#
# Production: set DATABASE_URL and DB_PASSWORD in .env on the server.
# SECURITY: chmod 600 .env

# PostgreSQL connection string.
# Not needed for local dev (docker-compose.yml sets this).
# Required on the production server:
#DATABASE_URL=postgresql+asyncpg://craft_dashboard:<DB_PASSWORD>@postgres/craft_dashboard

# PostgreSQL password for the postgres container.
# Not needed for local dev (docker-compose.yml uses hardcoded devpassword).
# Required on the production server:
#DB_PASSWORD=

# GitHub fine-grained token with read access to public repos
GITHUB_TOKEN=

# OpenRouter API key for server-side LLM evaluation
OPENROUTER_API_KEY=

# For local LLM evaluation, use the pull-based eval client.
# See docs/eval-client.md.

# Admin bearer token for protected endpoints
ADMIN_TOKEN=

# Eval API bearer token for /api/eval/* endpoints (pull-based evaluation)
EVAL_API_TOKEN=

# Toggle server-side LLM evaluation (set to false to disable run_llm evaluate)
ENABLE_SERVER_EVAL=true

# FastAPI debug mode (shows tracebacks in the browser)
DEBUG=false

# Log level for scripts (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
