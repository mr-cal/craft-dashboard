# Application configuration — used by pydantic-settings at startup.
#
# Local dev: docker-compose.yml sets DATABASE_URL automatically using
# the hardcoded devpassword. You do not need DATABASE_URL or DB_PASSWORD here.
#
# Production: set DATABASE_URL and DB_PASSWORD in .env on the server.
# SECURITY: chmod 600 .env

# PostgreSQL connection string.
# Not needed for local dev (docker-compose.yml sets this).
# Required on the production server:
#DATABASE_URL=postgresql+asyncpg://craft_dashboard:<DB_PASSWORD>@postgres/craft_dashboard

# PostgreSQL password for the postgres container.
# Not needed for local dev (docker-compose.yml uses hardcoded devpassword).
# Required on the production server:
#DB_PASSWORD=

# GitHub fine-grained token with read access to public repos
GITHUB_TOKEN=

# OpenRouter API key for server-side LLM evaluation
OPENROUTER_API_KEY=

# Admin bearer token for protected endpoints
ADMIN_TOKEN=

# Eval API bearer token for /api/eval/* endpoints (pull-based evaluation)
EVAL_API_TOKEN=

# Toggle server-side LLM evaluation (set to false to disable run_llm evaluate)
ENABLE_SERVER_EVAL=true

# FastAPI debug mode (shows tracebacks in the browser)
DEBUG=false

# Log level for scripts (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# DEV MACHINE ONLY — eval client settings (scripts/eval_client.py)
#
# These are read from .env by the eval client so you don't have to pass
# CLI flags every time. Do NOT set these on the production server; the
# eval client is not meant to run there.
# ---------------------------------------------------------------------------

# Base URL of the craft-dashboard server to pull eval work from
#EVAL_CLIENT_SERVER=http://localhost:8000

# PEM CA cert path for verifying the craft-dashboard server TLS cert (optional)
#EVAL_CLIENT_SERVER_CA_CERT=

# LLM model for summarization (cheaper/faster)
#LOCAL_LLM_SUMMARY_MODEL=llama3.2

# LLM model for scoring (more capable)
#LOCAL_LLM_EVALUATION_MODEL=llama3.2

# Embedding model for similarity search (served via Ollama or any OpenAI-compatible
# /v1/embeddings endpoint). Leave blank to skip embedding generation.
#LOCAL_LLM_EMBEDDING_MODEL=nomic-embed-text

# Related Issues panel on the issue detail page.
# Top-N similar issues to show (0 = disabled).
#RELATED_ISSUES_TOP_N=10
# Minimum cosine similarity (0–1). Issues below this threshold are excluded.
#RELATED_ISSUES_SIMILARITY_THRESHOLD=0.70

# OpenAI-compatible LLM endpoint (e.g. Ollama or a remote GPU box)
#LOCAL_LLM_URL=http://localhost:11434/v1

# API key for the LLM endpoint (leave empty for Ollama)
#LOCAL_LLM_API_KEY=

# PEM CA cert path for LLM server TLS verification (optional)
#LOCAL_LLM_CA_CERT=
