# ===========================================================================
# General & Shared Configuration
# ===========================================================================
# Craft-dashboard server URL to pull evaluation jobs from
# Local Dev:      https://craft-dashboard.name (or http://localhost:8000)
# Production VPS: http://craft-dashboard:8000
DASHBOARD_URL=

# Eval API bearer token (authenticates worker requests to /api/eval/*)
EVAL_API_TOKEN=

# GitHub token (shared: collector cron on server, local scripts/queries)
GITHUB_TOKEN=

DEBUG=false
LOG_LEVEL=INFO

# ===========================================================================
# LLM Backend Configuration
# ===========================================================================
# Choose a backend (OpenRouter or llama.cpp) by commenting/uncommenting.

# --- OpenRouter ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
# LLM_MODEL_SUMMARY=
# LLM_MODEL_SCORING=

# --- llama.cpp (local OpenAI-compatible server) ---
# LLM_BASE_URL=http://localhost:8080/v1
# LLM_API_KEY=
# LLM_MODEL=

# LLM & worker tuning
# LLM_TIMEOUT=600.0
# LLM_CA_CERT=
# DASHBOARD_CA_CERT=

# Git mirror storage for evaluation tools (git grep, git log)
# CRAFT_DASHBOARD_MIRROR_DIR=~/.cache/craft-dashboard/mirrors
# CRAFT_DASHBOARD_GIT_CONCURRENCY=2

# ===========================================================================
# Server Only (Production VPS: /opt/vps-infra/.env)
# ===========================================================================
# PostgreSQL connection string (server only; local evals use HTTP)
# DATABASE_URL=postgresql+asyncpg://craft_dashboard:<DB_PASSWORD>@postgres/craft_dashboard

# Admin bearer token for /api/admin/* endpoints
# ADMIN_TOKEN=

# API key for server-side semantic search & eval embeddings
# EMBEDDING_API_KEY=

# Retention window in days for superseded evaluation transcripts
# EVAL_TRANSCRIPT_RETENTION_DAYS=30

# Auto-pause evaluation when today's USD spend cap is reached (0.0 = unlimited)
# EVAL_DAILY_SPEND_CAP_USD=0.0

# Related issues tuning on the issue detail page
# RELATED_ISSUES_TOP_N=10
# RELATED_ISSUES_SIMILARITY_THRESHOLD=0.70

