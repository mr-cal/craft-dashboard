# ===========================================================================
# 1. SERVER ONLY (Production VPS: /opt/vps-infra/.env)
# ===========================================================================
# PostgreSQL connection string (server only; local dev uses sqlite or compose)
# DATABASE_URL=postgresql+asyncpg://craft_dashboard:<DB_PASSWORD>@postgres/craft_dashboard

# GitHub fine-grained token with read access to public repos (for data collection cron)
GITHUB_TOKEN=

# Admin bearer token for /api/admin/* endpoints
ADMIN_TOKEN=

# API key for server-side text embeddings (semantic search & eval embeddings)
EMBEDDING_API_KEY=

# Retention window in days for superseded evaluation transcripts
EVAL_TRANSCRIPT_RETENTION_DAYS=30

# Directory holding bare git mirrors for deep evaluation (default: ~/.cache/craft-dashboard/mirrors)
# CRAFT_DASHBOARD_MIRROR_DIR=/opt/vps-infra/mirrors

# Max concurrent git mirror processes (default: 2)
# CRAFT_DASHBOARD_GIT_CONCURRENCY=2

# Related issues tuning on the issue detail page
# RELATED_ISSUES_TOP_N=10
# RELATED_ISSUES_SIMILARITY_THRESHOLD=0.70

# ===========================================================================
# 2. SHARED (Required on both Server and Worker)
# ===========================================================================
# Eval API bearer token (authenticates worker requests to /api/eval/*)
EVAL_API_TOKEN=

# FastAPI debug mode (true/false)
DEBUG=false

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ===========================================================================
# 3. EVALUATION WORKER (Used by scripts/run_llm.py evaluate & VPS worker)
# ===========================================================================
# URL of the craft-dashboard server to pull jobs from
# Production VPS: http://craft-dashboard:8000
# Local Dev:      https://craft-dashboard.name (or http://localhost:8000)
DASHBOARD_URL=

# OpenAI-compatible LLM endpoint & credentials (REQUIRED for worker; no defaults)
# Works with OpenRouter, Ollama, vLLM, or any OpenAI-compatible provider.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional: Split models if summary & scoring use different models
# LLM_MODEL_SUMMARY=
# LLM_MODEL_SCORING=

# Optional worker tuning
# LLM_TIMEOUT=600.0
# LLM_CA_CERT=
# DASHBOARD_CA_CERT=
# EVAL_DAILY_SPEND_CAP_USD=0.0

