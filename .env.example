# Application configuration — used by pydantic-settings at startup.
#
# For local development: cp .env.example .env && edit .env
# For Docker: pass as env_file in docker-compose or set environment variables.
#
# SECURITY: After creating your .env, restrict file permissions:
#   chmod 600 .env

# PostgreSQL connection.
#
# For Docker Compose (using the postgres service):
#   DATABASE_URL=postgresql+asyncpg://craft_dashboard:<password>@postgres/craft_dashboard
#
# For local development (your own Postgres):
#   DATABASE_URL=postgresql+asyncpg://localhost/craft_dashboard
DATABASE_URL=postgresql+asyncpg://localhost/craft_dashboard

# GitHub fine-grained token with read access to public repos
GITHUB_TOKEN=

# LLM backend: "openrouter" or "local"
LLM_BACKEND=openrouter

# OpenRouter API key (required when LLM_BACKEND=openrouter)
OPENROUTER_API_KEY=

# Local LLM settings (used when LLM_BACKEND=local)
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_SUMMARY_MODEL=llama3.2
LOCAL_LLM_EVALUATION_MODEL=llama3.2
# Path to a PEM CA cert when LOCAL_LLM_URL uses https:// with a self-signed cert.
# The local-llm tool installs this at ~/.config/local-llm/cert.pem.
#LOCAL_LLM_CA_CERT=~/.config/local-llm/cert.pem

# Admin bearer token for protected endpoints
ADMIN_TOKEN=

# FastAPI debug mode (shows tracebacks in the browser)
DEBUG=false

# Log level for scripts (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
