[Unit]
Description=craft-dashboard PostgreSQL backup
After=postgresql.service

[Service]
Type=oneshot
User=postgres
ExecStart=/bin/bash -c 'pg_dump {{ db_name }} | gzip > {{ app_dir }}/backups/craft-dashboard-$(date +%%Y%%m%%d).sql.gz'
ExecStartPost=/bin/bash -c '\
  BACKUP=$(ls -t {{ app_dir }}/backups/craft-dashboard-*.sql.gz | head -1) && \
  createdb {{ db_name }}_restore_test 2>/dev/null; \
  gunzip -c "$BACKUP" | psql -q {{ db_name }}_restore_test > /dev/null 2>&1 && \
  echo "Backup restore test passed: $BACKUP" || \
  echo "WARNING: Backup restore test FAILED: $BACKUP"; \
  dropdb --if-exists {{ db_name }}_restore_test'
ExecStartPost=/bin/bash -c 'find {{ app_dir }}/backups -name "*.sql.gz" -mtime +7 -delete'
StandardOutput=journal
StandardError=journal
