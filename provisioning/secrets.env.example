# Copy this file to secrets.env, fill in your values.
# secrets.env is gitignored — never commit it.
#
# Run deployments with:
#   make deploy-vm   (LXD VM)
#   make deploy      (VPS)

# LXD VM name (used for local lxc commands — not sent to Ansible)
VM_NAME=craft-dashboard-dev

# Target host (VPS IP or LXD VM IP — update after each lxc launch)
DASHBOARD_HOST=your-vps-ip

# SSH user on the target (default: ubuntu; local-llm VMs use your host username)
DASHBOARD_USER=ubuntu

# Path to SSH private key
DASHBOARD_SSH_KEY=~/.ssh/id_ed25519

# PostgreSQL password (choose a strong password for production)
DB_PASSWORD=change-me

# GitHub fine-grained token with read access to public repos
GITHUB_TOKEN=

# Domain name pointing to the server (leave as localhost for LXD testing)
DOMAIN_NAME=dashboard.example.com

# Let's Encrypt email (only used when SSL is enabled)
SSL_EMAIL=admin@example.com

# Optional: OpenRouter API key (for LLM evaluation in production)
OPENROUTER_API_KEY=

# Optional: admin bearer token for protected API endpoints
ADMIN_TOKEN=
