# Deployment configuration for craft-dashboard.
#
# Copy to secrets.env, fill in your values, then run:
#   make deploy-vm   (LXD VM, no SSL)
#   make deploy      (VPS, with SSL)
#
# This file is gitignored. Never commit it.
#
# How it works: the Makefile sources this file, then runs Ansible.
# Ansible reads these values with lookup('env', ...) and writes them
# into /opt/craft-dashboard/.env on the server. To change any app
# setting on the server, edit this file and re-deploy.


# --- Ansible connection (where to deploy) ---

VM_NAME=craft-dashboard-dev
DASHBOARD_HOST=your-vps-ip
DASHBOARD_USER=ubuntu
DASHBOARD_SSH_KEY=~/.ssh/id_ed25519


# --- Server infrastructure ---

DB_PASSWORD=change-me
DOMAIN_NAME=localhost
SSL_EMAIL=admin@example.com


# --- Secrets (written to the server's .env) ---

GITHUB_TOKEN=
OPENROUTER_API_KEY=
ADMIN_TOKEN=


# --- App settings (optional, all have sensible defaults) ---

# Log level for scripts: DEBUG, INFO, WARNING, ERROR
#LOG_LEVEL=INFO

# How many days before re-fetching an issue from GitHub
#REFRESH_AGE_DAYS=7

# LLM backend: "openrouter" (default) or "local"
#LLM_BACKEND=openrouter

# Local LLM settings (only needed when LLM_BACKEND=local).
# Point to any OpenAI-compatible API, e.g. ollama or vllm.
#LOCAL_LLM_URL=https://192.168.1.64:8443/v1
#LOCAL_LLM_API_KEY=
#LOCAL_LLM_SUMMARY_MODEL=llama3.2
#LOCAL_LLM_EVALUATION_MODEL=llama3.2
# Path to the server's CA certificate (PEM) when LOCAL_LLM_URL uses https://
# with a self-signed cert. Copy the cert to the VM first, then set this path:
#   lxc file push ~/.config/local-llm/cert.pem $VM_NAME/opt/craft-dashboard/local-llm-cert.pem
#LOCAL_LLM_CA_CERT=/opt/craft-dashboard/local-llm-cert.pem
